# Back2U Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment

APP_NAME="Back2U API"
APP_ENV="development"
DEBUG=true

# Database: Default to SQLite for local development or PostgreSQL with pgvector for production
# Local SQLite: sqlite:///./back2u.db
# PostgreSQL with pgvector: postgresql://postgres:postgrespassword@localhost:5432/back2u
DATABASE_URL=sqlite:///./back2u.db

# Authentication Secret
SECRET_KEY=back2u_super_secret_jwt_key_2026_hackathon_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Firebase Authentication (Optional in local development; required for production Firebase Admin SDK)
# Path to your Firebase serviceAccountKey.json downloaded from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=

# Local Upload Directory or Cloudinary/S3 adapter
UPLOAD_DIR=uploads

# AI Multi-Modal Match Ranking Default Weights (Must sum to 1.0)
WEIGHT_IMAGE=0.40
WEIGHT_TEXT=0.35
WEIGHT_LOCATION=0.15
WEIGHT_DATE=0.10

# Trust & Reputation Points Parameters
INITIAL_TRUST_SCORE=100
POINTS_FOUND_REPORT=50
POINTS_RECOVERY_CONFIRMED=150
PENALTY_SUSPICIOUS_CLAIM=5
PENALTY_FALSE_CLAIM=10
PENALTY_FRAUDULENT_CLAIM=25
