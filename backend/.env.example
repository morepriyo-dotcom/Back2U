# Back2U Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Never commit .env with real production secrets to version control.

# Application Environment: 'development', 'staging', or 'production'
APP_NAME="Back2U API"
APP_ENV="development"
DEBUG=true

# Database Configuration
# Local Development SQLite: sqlite:///./back2u.db
# Production PostgreSQL (with pgvector extension):
# DATABASE_URL=postgresql://postgres:<SECURE_PASSWORD>@localhost:5432/back2u
DATABASE_URL=sqlite:///./back2u.db

# Authentication Security
# In production, SECRET_KEY must be a cryptographically random string (min 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_secret_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list of exact frontend URLs)
# In production, restrict strictly to your production domain(s), e.g. https://back2u.org
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Feature Flags (Automatically forced to false in production)
ENABLE_DEMO_LOGIN=true
ENABLE_AUTO_SEED=true

# Storage Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Firebase Admin & Cloud Firestore Database Configuration
# 1. Open Firebase Console -> Project Settings -> Service accounts
# 2. Click "Generate new private key" to download your serviceAccountKey.json
# 3. Place the file inside 'backend/' or specify its path here:
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Optional Real SMS Carrier Gateways (For physical phone SMS dispatch)
# Fast2SMS (India): https://www.fast2sms.com/
FAST2SMS_API_KEY=
# Twilio (International): https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI Neural Embedding Engine Configuration
# HuggingFace model identifier for SentenceTransformer
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
# OpenCLIP architecture and pretrained weights tag
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k

# AI Multi-Modal Match Ranking Default Weights (Must sum to 1.0)
WEIGHT_IMAGE=0.40
WEIGHT_TEXT=0.35
WEIGHT_LOCATION=0.15
WEIGHT_DATE=0.10

# Reputation & Trust Parameters
INITIAL_TRUST_SCORE=100
POINTS_FOUND_REPORT=50
POINTS_RECOVERY_CONFIRMED=150
PENALTY_SUSPICIOUS_CLAIM=5
PENALTY_FALSE_CLAIM=10
PENALTY_FRAUDULENT_CLAIM=25
