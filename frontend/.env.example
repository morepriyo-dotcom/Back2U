# Back2U Frontend Environment Configuration Template
# Copy this file to .env or .env.local

# Backend API Base URL
VITE_API_URL=http://127.0.0.1:8000

# -------------------------------------------------------------
# Firebase Web App & Database Configuration
# Obtain these values from Firebase Console (https://console.firebase.google.com/):
# 1. Open your Firebase project -> Project Settings -> General -> "Your apps" -> Web app (</>)
# 2. Copy the firebaseConfig properties below:
# -------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase Realtime Database URL (if using Realtime Database in addition to Cloud Firestore)
# Format: https://<your-project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=
